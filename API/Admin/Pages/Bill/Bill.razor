@page "/bill"
@using QRCoder
@using System.Drawing.Imaging
@using System.IO
@using System.Text
@inject IJSRuntime jsRuntime
@inject HttpClient HttpClient

<style>
    /* CSS styles here */
</style>

<div id="printableArea" class="panel panel-primary">
    <div class="panel-heading">
        <h2>Thông Tin Hóa Đơn</h2>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th style="width: 200px">Mã hóa đơn</th>
                <th style="width: 150px">Ngày</th>
                <th style="width: 200px">Thành tiền</th>
                <th style="width: 250px">Người dùng</th>
                <th style="width: 200px">Trạng thái</th>
                <th style="width: 300px">Mã QR</th>
                <th style="width: 200px">Xem chi tiết</th>
                <th style="width: 200px">Sửa</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bills in bill)
            {
                <tr>
                    <td>@bills.BillId</td>
                    <td>@bills.Date.ToShortDateString()</td>
                    <td>@bills.Total.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VNĐ</td>
                    <td>@bills.User.Name</td>
                    <td>@bills.Status.Name</td>
                    <td>
                        <img src="@GenerateQRCode(bills.BillId)" width="150px" height="150px" alt="QR Code" />
                    </td>
                    <td><a href="/billdetails/@bills.BillId">Xem chi tiết</a></td>
                    <td><a href="/EditBill/@bills.BillId">Sửa</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    string urlBill = "http://localhost:20714/api/Bills";
    string urlPro = "http://localhost:20714/api/Products";
    string urlSizeProduct = "http://localhost:20714/api/Size_Product";
    string urlBillDetails = "http://localhost:20714/api/BillDetails";
    private bool IsLoggedIn = false;
    private int RoleID = 0;

    public IEnumerable<Admin.Model.Bill> bill { get; set; } = Enumerable.Empty<Admin.Model.Bill>();
    public IEnumerable<Product> products { get; set; } = Enumerable.Empty<Product>();
    public IEnumerable<BillDetail> billDetails { get; set; } = Enumerable.Empty<BillDetail>();

    protected async override Task OnInitializedAsync()
    {
        await CallAPI();

        foreach (var billItem in bill)
        {
            if (billItem.StatusID == 1)
            {
                _ = ChangeStatusAfterDelay(billItem.BillId);
            }
        }
    }

    private async Task ChangeStatusAfterDelay(int billId)
    {
        await Task.Delay(5000);
        var billToUpdate = bill.FirstOrDefault(b => b.BillId == billId);
        if (billToUpdate != null && billToUpdate.StatusID == 1)
        {
            billToUpdate.StatusID = 2;
            await UpdateBillStatusInDatabase(billToUpdate.BillId, billToUpdate.StatusID);
            StateHasChanged();
        }
    }

    private async Task UpdateBillStatusInDatabase(int billId, int newStatusId)
    {
        var content = new StringContent(JsonConvert.SerializeObject(newStatusId), Encoding.UTF8, "application/json");
        var response = await HttpClient.PutAsync($"{urlBill}/{billId}/update-status", content);

        if (response.IsSuccessStatusCode)
        {
            Console.WriteLine($"Cập nhật trạng thái của hóa đơn {billId} thành công.");
        }
        else
        {
            Console.WriteLine($"Lỗi khi cập nhật trạng thái của hóa đơn {billId}.");
        }
    }

    async Task CallAPI()
    {
        var billResponse = await HttpClient.GetStringAsync(urlBill);
        bill = JsonConvert.DeserializeObject<List<Admin.Model.Bill>>(billResponse);

        var productResponse = await HttpClient.GetStringAsync(urlPro);
        products = JsonConvert.DeserializeObject<List<Product>>(productResponse);

        var billDetailResponse = await HttpClient.GetStringAsync(urlBillDetails);
        billDetails = JsonConvert.DeserializeObject<List<BillDetail>>(billDetailResponse);
    }

    private string GenerateQRCode(int billId)
    {
        if (billDetails == null || !billDetails.Any())
        {
            return string.Empty; // Handle as needed
        }

        var billDetailsForBill = billDetails.Where(d => d.BillID == billId).ToList();

        if (!billDetailsForBill.Any())
        {
            return string.Empty; // Handle as needed
        }

        var qrText = $"Hóa đơn: {billId}\n";
        foreach (var detail in billDetailsForBill)
        {
            var productName = products.FirstOrDefault(p => p.ProductID == detail.ProductID)?.Name ?? "N/A";

            qrText += $"Tên sản phẩm: {productName}\n" +
                      $"Số lượng: {detail.Quality}\n" +
                      $"Tổng tiền: {detail.Subtotal.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))} VNĐ\n";
        }

        using (var qrGenerator = new QRCodeGenerator())
        {
            var qrCodeData = qrGenerator.CreateQrCode(qrText, QRCodeGenerator.ECCLevel.Q);
            using (var qrCode = new QRCode(qrCodeData))
            {
                using (var bitmap = qrCode.GetGraphic(20))
                {
                    using (var stream = new MemoryStream())
                    {
                        bitmap.Save(stream, ImageFormat.Png);
                        byte[] byteArray = stream.ToArray();
                        return "data:image/png;base64," + Convert.ToBase64String(byteArray);
                    }
                }
            }
        }
    }
}