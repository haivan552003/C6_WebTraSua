@page "/stats/users"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<style>
    .panel {
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .panel-heading {
        background-color: #007bff;
        color: white;
        padding: 15px 15px 5px 15px;
        border-radius: 8px 8px 0 0;
    }

        .panel-heading h2 {
            margin: 0;
        }

    .table {
        margin: 20px 0;
        border-collapse: collapse;
        width: 100%;
    }

        .table th, .table td {
            border: 1px solid #dee2e6;
            padding: 12px;
            text-align: left;
        }

        .table th {
            background-color: #f8f9fa;
            color: #495057;
        }

        .table tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .table tr:hover {
            background-color: #e9ecef;
        }

    select, input {
        padding: 5px;
        margin: 5px 10px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 1em;
    }

    .btn-search {
        height: 40px;
        margin-right: 15px;
    }

    label {
        font-weight: bold;
        margin-right: 5px;
    }
</style>

<div class="panel panel-primary">
    <div class="panel-heading">
        <h2>Thống Kê Doanh Thu Theo Người Dùng</h2>
        <div>
            <label for="year">Chọn năm:</label>
            <input type="number" id="year" @bind="selectedYear" min="2000" max="2100" />

            <label for="month">Chọn tháng:</label>
            <input type="number" id="month" @bind="selectedMonth" min="1" max="12" />

            <button class="btn-search btn btn-primary" @onclick="FetchUserStats">Xem thống kê</button>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Tên Người Dùng</th>
                <th>Tổng Doanh Thu</th>
                <th>Tổng Số Hóa Đơn</th>
                <th>Trạng Thái</th>
                <th>Doanh Thu Theo Trạng Thái</th>
                <th>Số Lượng Hóa Đơn Theo Trạng Thái</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var userStat in UserStats)
            {
                <tr>
                    <td>@userStat.UserName</td>
                    <td>@userStat.TotalRevenue.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VND</td>
                    <td>@userStat.TotalBills</td>
                    <td>
                        @foreach (var statusStat in userStat.StatusStats)
                        {
                            <div>@statusStat.Status</div>
                        }
                    </td>
                    <td>
                        @foreach (var statusStat in userStat.StatusStats)
                        {
                            <div>@statusStat.TotalRevenue.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VND</div>
                        }
                    </td>
                    <td>
                        @foreach (var statusStat in userStat.StatusStats)
                        {
                            <div>@statusStat.TotalBills</div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private int selectedYear = DateTime.Now.Year;
    private int selectedMonth = DateTime.Now.Month;
    private IEnumerable<UserStatsResponse> UserStats { get; set; } = Enumerable.Empty<UserStatsResponse>();

    private async Task FetchUserStats()
    {
        var url = $"http://localhost:20714/api/Bills/stats/user?year={selectedYear}&month={selectedMonth}";

        try
        {
            var response = await Http.GetFromJsonAsync<UserStatsResponseWrapper>(url);
            UserStats = response?.UserStats ?? Enumerable.Empty<UserStatsResponse>();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching user stats: {ex.Message}");
        }
    }

    public class UserStatsResponseWrapper
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public List<UserStatsResponse> UserStats { get; set; }
    }

    public class UserStatsResponse
    {
        public int UserID { get; set; }
        public string UserName { get; set; }
        public List<StatusStat> StatusStats { get; set; }
        public decimal TotalRevenue { get; set; }
        public int TotalBills { get; set; }
    }

    public class StatusStat
    {
        public string Status { get; set; }
        public decimal TotalRevenue { get; set; }
        public int TotalBills { get; set; }
    }
}
