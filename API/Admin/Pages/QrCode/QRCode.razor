@page "/qrcode"
@inject IJSRuntime jsRuntime
<h3>QRCode</h3>
@using Syncfusion.Blazor.BarcodeGenerator
<EditForm Model="@DataModel">
    <div class="row">
           <div class="col-10">
               <div class="form-group">
                   <label>Enter value</label>
                   <input type="text" @bind-value="DataModel.QrInputValue" />
               </div>
           </div>
           <div class="col-10">
                <button class="btn btn-primary" @onclick="GenerateClick">GenerateClick</button>
           </div>
    </div>
</EditForm>
@if(DataModel.QrInputValue != null && DataModel.QrInputValue.Trim() != "")
{
    <SfQRCodeGenerator Width="200px" Height="150px" Value="@DataModel.QrInputValue">

    </SfQRCodeGenerator>
}
@code {
    private bool IsLoggedIn = false;
    private int RoleID = 0;
    public QRCodeDataModel DataModel = new QRCodeDataModel();
    public class QRCodeDataModel
    {
        public string QrInputValue { get; set; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GetSession();
        }
    }

    private async Task GetSession()
    {
        await Task.Delay(100);
        var userInfoJson = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userSession");
        if (!string.IsNullOrEmpty(userInfoJson))
        {
            var userInfo = JsonConvert.DeserializeObject<UserLogin>(userInfoJson);
            if (userInfo != null)
            {
                IsLoggedIn = true;
                RoleID = userInfo.RoleID;
            }
        }
    }
    protected void GenerateClick()
    {
        
    }
}
