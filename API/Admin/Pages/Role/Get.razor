@page "/get"
@inject IJSRuntime jsRuntime
@inject NavigationManager Navigation

<PageTitle>get role</PageTitle>
<h3>Get</h3>

<table>
    <tr>
        <th>Name</th>
    </tr>
    @foreach (Roles roles in Roless)
    {
        <tr>
            <td>@roles.Name</td>
        </tr>
    }
</table>

@code {
    string url = "http://localhost:20714/api/Roles";

    public IEnumerable<Roles> Roless { get; set; } = Enumerable.Empty<Roles>();

    private bool IsLoggedIn = false;
    private int RoleID = 0;
    private bool firstRenderCompleted = false;

    protected override async Task OnInitializedAsync()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !firstRenderCompleted)
        {
            firstRenderCompleted = true;

            await GetSession();

            if (!IsLoggedIn)
            {
                Navigation.NavigateTo("/"); 
            }
            else
            {
                await CallAPI();
            }

            StateHasChanged();
        }
    }

    async Task CallAPI()
    {
        using (var httpClient = new HttpClient())
        {
            using (var response = await httpClient.GetAsync(url))
            {
                string apiResponse = await response.Content.ReadAsStringAsync();
                Roless = JsonConvert.DeserializeObject<List<Roles>>(apiResponse);
            }
        }
    }

    private async Task GetSession()
    {
        var userInfoJson = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userSession");
        if (!string.IsNullOrEmpty(userInfoJson))
        {
            var userInfo = JsonConvert.DeserializeObject<UserLogin>(userInfoJson);
            if (userInfo != null)
            {
                IsLoggedIn = true;
                RoleID = userInfo.RoleID;
            }
        }
    }
}
