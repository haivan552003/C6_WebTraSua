@page "/EditCategoris/{id:int}"
@using System.Text
@inject IJSRuntime jsRuntime
@inject NavigationManager Navigation

<div class="panel-heading"><h2>Sửa Danh Mục Sản Phẩm</h2></div>

<EditForm Model="proData" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label class="font-weight-bold">Tiêu Đề</label>
        <InputText class="form-control" @bind-Value="proData.Name" />
        <div class="text-danger ps-3">
            <ValidationMessage For="()=>proData.Name"></ValidationMessage>
        </div>
    </div>

    <div class="form-group">
        <label class="font-weight-bold">Trạng Thái</label>
        <InputSelect class="form-control" @bind-Value="proData.Status">
            <option value="0">Hiện</option>
            <option value="1">Ẩn</option>
        </InputSelect>

        <div class="text-danger ps-3">
            <ValidationMessage For="()=>proData.Status"></ValidationMessage>
        </div>
    </div>

    <div class="form-group">
        <label class="font-weight-bold">Hình Ảnh Hiện Tại</label>
        <div>
            <img src="@GetImagePath(proData.Image)" alt="Current Image" width="150" height="150" />
        </div>
    </div>

    <div class="form-group">
        <label class="font-weight-bold">Tải Lên Hình Ảnh Mới</label> <br />
        <InputFile OnChange="HandleFileSelected" />
        <div class="text-danger ps-3">
            <ValidationMessage For="()=>proData.Image"></ValidationMessage>
        </div>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Sửa Danh Mục</button>
    </div>
</EditForm>

<h2 class="text-success p-2">@FormSubmitMessage</h2>

@code {
    private IBrowserFile selectedFile;
    private string imageBaseUrl = "http://localhost:20714/images"; // Đường dẫn cơ bản tới thư mục chứa hình ảnh

    string urlCate = "http://localhost:20714/api/Categories";
    public Categories proData = new Categories();
    Categories ReceivedBlog;
    public string FormSubmitMessage { get; set; } = string.Empty;

    private bool IsLoggedIn = false;
    private int RoleID = 0;
    private bool firstRenderCompleted = false;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !firstRenderCompleted)
        {
            firstRenderCompleted = true;

            await GetSession();

            if (!IsLoggedIn)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
            }

            StateHasChanged();
        }
    }


    private async Task GetSession()
    {
        await Task.Delay(100);
        var userInfoJson = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userSession");
        if (!string.IsNullOrEmpty(userInfoJson))
        {
            var userInfo = JsonConvert.DeserializeObject<UserLogin>(userInfoJson);
            if (userInfo != null)
            {
                IsLoggedIn = true;
                RoleID = userInfo.RoleID;
            }
        }
    }
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        proData.Image = selectedFile.Name; // Đặt tên file vào model proData
    }


    protected async override Task OnParametersSetAsync()
    {
        using (var httpClient = new HttpClient())
        {
            using (var response = await httpClient.GetAsync($"{urlCate}/{Id}"))
            {
                string apiResponse = await response.Content.ReadAsStringAsync();
                var categoriesList = JsonConvert.DeserializeObject<List<Categories>>(apiResponse);
                proData = categoriesList.FirstOrDefault(c => c.CateID == Id);
            }
        }
    }

    public async Task HandleValidSubmit()
    {
        if (selectedFile != null)
        {
            var content = new MultipartFormDataContent();
            content.Add(new StreamContent(selectedFile.OpenReadStream()), "file", selectedFile.Name);
            content.Add(new StringContent(proData.Name), "name");
            content.Add(new StringContent(proData.Status.ToString()), "status");

            using (var httpClient = new HttpClient())
            {
                var response = await httpClient.PutAsync($"{urlCate}/UploadFile/{proData.CateID}", content);

                if (response.IsSuccessStatusCode)
                {
                    FormSubmitMessage = "Sửa thành công!";
                }
                else
                {
                    FormSubmitMessage = "Sửa thất bại: " + response.ReasonPhrase;
                }
            }
        }
        else
        {
            await UpdateCategoryWithoutImage();
        }
    }

    private async Task UpdateCategoryWithoutImage()
    {
        using (var httpClient = new HttpClient())
        {
            var jsonContent = new StringContent(JsonConvert.SerializeObject(proData), Encoding.UTF8, "application/json");

            using (var response = await httpClient.PutAsync($"{urlCate}/{proData.CateID}", jsonContent))
            {
                string apiResponse = await response.Content.ReadAsStringAsync();
                if (response.IsSuccessStatusCode)
                {
                    FormSubmitMessage = "Sửa thành công!";
                }
                else
                {
                    FormSubmitMessage = "Sửa thất bại: " + apiResponse;
                }
            }
        }
    }
    private string GetImagePath(string imageName) => $"http://localhost:49972/images/{imageName}";

    public void HandleInvalidSubmit() => FormSubmitMessage = "Dữ liệu không hợp lệ, vui lòng kiểm tra lại.";
}
